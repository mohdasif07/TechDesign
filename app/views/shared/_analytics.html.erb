<%# Google Analytics 4 — loaded globally via layouts/application.html.erb %>
<% ga_measurement_id = ENV.fetch("GOOGLE_ANALYTICS_ID", "G-6SZB27LNNR") %>
<% if ga_measurement_id.present? %>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_measurement_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag("js", new Date());
    gtag("config", "<%= ga_measurement_id %>");
  </script>
<% end %>
