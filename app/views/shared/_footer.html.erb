<footer>
  <div class="container footer-inner">
    <div>
      <%= link_to root_path, class: "brand footer-brand" do %>
        <%= image_tag "/logo-mark.svg", alt: "", class: "brand-logo", width: 38, height: 38 %>
        <span class="brand-name">Arqvexa</span>
      <% end %>
      <p>Interior Design &amp; IT Development. Delhi NCR &amp; Remote.</p>
      <ul class="footer-contact">
        <li><%= mail_to contact_email, contact_email %></li>
        <li><%= link_to contact_phone_display, "tel:#{contact_phone_tel}" %></li>
        <li><%= link_to "WhatsApp", "https://wa.me/919917639330", target: "_blank", rel: "noopener noreferrer" %></li>
      </ul>
    </div>
    <div class="footer-links">
      <%= link_to "Interior Design", interior_design_path %>
      <%= link_to "IT Development", it_development_path %>
      <%= link_to "Portfolio", portfolio_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_page_path %>
      <%= link_to "Privacy", privacy_path %>
    </div>
    <div class="copyright">
      <div>© <%= Time.current.year %> Arqvexa. All rights reserved.</div>
      <%= link_to "Privacy Policy", privacy_path, class: "footer-legal-link" %>
    </div>
  </div>
</footer>
