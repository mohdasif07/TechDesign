<footer>
  <div class="container footer-inner">
    <div>
      <%= link_to root_path, class: "brand footer-brand" do %>
        <%= image_tag "/logo-mark.svg", alt: "", class: "brand-logo", width: 38, height: 38 %>
        <span class="brand-name">Arqvexa</span>
      <% end %>
      <p>Interior Design & IT Development. Delhi NCR & Remote.</p>
    </div>
    <div class="footer-links">
      <%= link_to "Interior Design", interior_design_path %>
      <%= link_to "IT Development", web_development_path %>
      <%= link_to "Portfolio", portfolio_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", root_path(anchor: "about") %>
      <%= link_to "Contact", root_path(anchor: "contact") %>
    </div>
    <div class="copyright">© <%= Time.current.year %> Arqvexa. All rights reserved.</div>
  </div>
</footer>
