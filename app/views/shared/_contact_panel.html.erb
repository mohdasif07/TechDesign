<div class="contact-panel reveal delay-1">
  <h3 class="contact-form-title">Send us a message</h3>
  <p class="contact-form-lead">Fill the form and we will reply to your email within 24 hours.</p>

  <%= render "shared/contact_form",
        default_service: local_assigns[:default_service],
        return_to: local_assigns.fetch(:return_to, request.path + "#contact") %>
</div>
