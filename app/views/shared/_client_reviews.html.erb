<% division = local_assigns.fetch(:division).to_s %>
<% reviews = ClientReview.for_division(division) %>
<% return if reviews.empty? %>

<% variant = division == "interior" ? "interior" : "tech" %>
<% lead =
     if variant == "interior"
       "What residential and commercial clients across Delhi NCR say about working with us."
     else
       "What founders and teams say about our websites, apps and custom software work."
     end %>

<section class="section client-reviews client-reviews--<%= variant %>" id="reviews" aria-labelledby="client-reviews-heading-<%= variant %>">
  <div class="container">
    <div class="section-head compact client-reviews-head reveal">
      <div>
        <div class="eyebrow"><span></span> Client reviews</div>
        <h2 id="client-reviews-heading-<%= variant %>">
          <% if variant == "interior" %>
            Loved by <em>homeowners &amp; businesses.</em>
          <% else %>
            Trusted by <em>founders &amp; teams.</em>
          <% end %>
        </h2>
      </div>
      <p><%= lead %></p>
    </div>

    <div class="client-reviews-grid reveal">
      <% reviews.each_with_index do |review, index| %>
        <% delay_class = index.positive? ? " delay-#{[index, 3].min}" : nil %>
        <article class="client-review-card <%= delay_class %>">
          <div class="client-review-card-inner">
            <div class="client-review-meta">
              <%= review_stars(review.rating) %>
              <span class="client-review-project"><%= review.project %></span>
            </div>

            <blockquote cite="#reviews">
              <p><%= review.quote %></p>
            </blockquote>

            <div class="client-review-author">
              <span class="client-review-avatar" aria-hidden="true"><%= review.initials %></span>
              <div class="client-review-author-text">
                <strong><%= review.name %></strong>
                <div class="client-review-author-meta">
                  <span class="client-review-role"><%= review.role %></span>
                  <span class="client-review-sep" aria-hidden="true"></span>
                  <span class="client-review-location"><%= review.location %></span>
                </div>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <%= render "shared/google_review_cta" %>
  </div>
</section>
