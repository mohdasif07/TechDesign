<% division = local_assigns.fetch(:division).to_s %>
<% reviews = ClientReview.for_division(division) %>
<% return if reviews.empty? %>

<% variant = division == "interior" ? "interior" : "tech" %>
<% lead =
     if variant == "interior"
       "Feedback from residential and commercial interior clients across Delhi NCR."
     else
       "Feedback from businesses we have helped with websites, apps and custom software."
     end %>

<section class="section client-reviews client-reviews--<%= variant %>" id="reviews" aria-labelledby="client-reviews-heading-<%= variant %>">
  <div class="container">
    <div class="client-reviews-layout reveal">
      <div class="client-reviews-intro">
        <div class="eyebrow"><span></span> Client reviews</div>
        <h2 id="client-reviews-heading-<%= variant %>">
          <% if variant == "interior" %>
            Trusted by <em>homeowners &amp; businesses.</em>
          <% else %>
            Trusted by <em>founders &amp; teams.</em>
          <% end %>
        </h2>
        <p><%= lead %></p>

        <div class="client-reviews-trust" aria-hidden="true">
          <div class="client-reviews-trust-item">
            <strong><%= reviews.size %></strong>
            <span>Featured reviews</span>
          </div>
          <div class="client-reviews-trust-item">
            <strong>5★</strong>
            <span>Client satisfaction</span>
          </div>
        </div>
      </div>

      <div class="client-reviews-grid">
        <% reviews.each_with_index do |review, index| %>
          <% delay_class = index.positive? ? " delay-#{[index, 3].min}" : nil %>
          <article class="client-review-card reveal <%= delay_class %>">
            <div class="client-review-top">
              <%= review_stars(review.rating) %>
              <span class="client-review-project"><%= review.project %></span>
            </div>

            <blockquote cite="#reviews">
              <p><%= review.quote %></p>
            </blockquote>

            <footer class="client-review-author">
              <span class="client-review-avatar" aria-hidden="true"><%= review.initials %></span>
              <div>
                <strong><%= review.name %></strong>
                <span><%= review.role %> · <%= review.location %></span>
              </div>
            </footer>
          </article>
        <% end %>
      </div>
    </div>
  </div>
</section>
