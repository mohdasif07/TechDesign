<article class="work-card portfolio-card <%= item.work_card_class %>" data-category="<%= item.category %>">
  <% if item.cover_image.present? %>
    <div class="portfolio-card-photo">
      <%= image_tag portfolio_image_file(item.cover_image, format: "webp"), alt: "#{item.title} — #{item.tag}", loading: "lazy", decoding: "async" %>
    </div>
  <% else %>
  <% case item.visual %>
  <% when "warehouse" %>
    <div class="visual-tech visual-warehouse" aria-hidden="true">
      <div class="tech-panel">
        <div class="tech-topbar"><span></span><span></span><span></span><b>Storeman · WMS</b></div>
        <div class="wh-grid">
          <div class="wh-bay"><i></i><i></i><i></i></div>
          <div class="wh-bay filled"><i></i><i></i><i></i></div>
          <div class="wh-bay"><i></i><i></i></div>
          <div class="wh-bay filled"><i></i><i></i><i></i></div>
        </div>
        <div class="wh-stats"><span></span><span></span><span></span></div>
      </div>
    </div>
  <% when "ai" %>
    <div class="visual-tech visual-ai" aria-hidden="true">
      <div class="tech-panel">
        <div class="tech-topbar"><span></span><span></span><span></span><b>AI Admin · Agents</b></div>
        <div class="ai-layout">
          <div class="ai-agents">
            <div class="ai-agent on"><em></em><span></span></div>
            <div class="ai-agent"><em></em><span></span></div>
            <div class="ai-agent on"><em></em><span></span></div>
          </div>
          <div class="ai-chat">
            <div class="ai-bubble bot"></div>
            <div class="ai-bubble user"></div>
            <div class="ai-bubble bot short"></div>
            <div class="ai-pulse"></div>
          </div>
        </div>
      </div>
    </div>
  <% when "geofence" %>
    <div class="visual-tech visual-geofence" aria-hidden="true">
      <div class="geo-map">
        <div class="geo-ring"></div>
        <div class="geo-ring geo-ring--inner"></div>
        <div class="geo-pin"></div>
        <div class="geo-roads"><i></i><i></i><i></i></div>
      </div>
      <div class="geo-phone">
        <div class="geo-phone-bar"></div>
        <div class="geo-check">IN</div>
        <div class="geo-status"></div>
      </div>
    </div>
  <% when "erp" %>
    <div class="visual-tech visual-erp" aria-hidden="true">
      <div class="erp-node">
        <strong>Storeman</strong>
        <span></span><span></span><span></span>
      </div>
      <div class="erp-sync">
        <i></i><i></i><i></i>
        <b>OData</b>
      </div>
      <div class="erp-node erp-node--bc">
        <strong>Business Central</strong>
        <span></span><span></span><span></span>
      </div>
    </div>
  <% when "reports" %>
    <div class="visual-tech visual-reports" aria-hidden="true">
      <div class="tech-panel">
        <div class="tech-topbar"><span></span><span></span><span></span><b>MIS · Control Reports</b></div>
        <div class="rpt-body">
          <div class="rpt-filters"><span></span><span></span><span></span></div>
          <div class="rpt-chart">
            <i style="--h:42%"></i>
            <i style="--h:68%"></i>
            <i style="--h:55%"></i>
            <i style="--h:82%"></i>
            <i style="--h:48%"></i>
            <i style="--h:74%"></i>
          </div>
          <div class="rpt-rows"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
  <% when "devops" %>
    <div class="visual-tech visual-devops" aria-hidden="true">
      <div class="dev-terminal">
        <div class="tech-topbar"><span></span><span></span><span></span><b>prod · deploy</b></div>
        <div class="dev-lines">
          <code>$ git push origin main</code>
          <code>→ nginx · puma · ssl</code>
          <code>✓ docker up · migrate</code>
          <code class="ok">deployed · healthy</code>
        </div>
      </div>
      <div class="dev-pipeline">
        <span>Build</span><i></i><span>Test</span><i></i><span>Ship</span>
      </div>
    </div>
  <% when "digital" %>
    <div class="visual-digital"><div class="browser"><span></span><span></span><span></span><div class="browser-title">Your Business, Online.</div><div class="browser-lines"></div></div></div>
  <% when "mobile" %>
    <div class="visual-mobile"><div class="phone"><div class="phone-notch"></div><div class="phone-screen"><div class="app-bar"></div><div class="app-card"></div><div class="app-card short"></div></div></div></div>
  <% when "crm" %>
    <div class="visual-crm"><div class="dashboard"><div class="dash-sidebar"></div><div class="dash-main"><div class="dash-stat"></div><div class="dash-stat"></div><div class="dash-chart"></div></div></div></div>
  <% when "room" %>
    <div class="visual-room"><div class="v-window"></div><div class="v-sofa"></div><div class="v-table"></div><div class="v-light"></div></div>
  <% when "office" %>
    <div class="visual-office"><div class="desk"></div><div class="screen"></div><div class="plant2"></div><div class="chair"></div></div>
  <% when "kitchen" %>
    <div class="visual-kitchen"><div class="k-counter"></div><div class="k-cabinets"></div><div class="k-hood"></div><div class="k-island"></div></div>
  <% end %>
  <% end %>
  <div class="work-meta">
    <span><%= item.tag %></span>
    <b><%= item.title %></b>
    <p><%= item.description %></p>
    <% if item.concept? %>
      <small class="portfolio-badge portfolio-badge--concept">Studio concept</small>
    <% end %>
    <% if item.location.present? %>
      <small class="portfolio-location"><%= item.location %></small>
    <% end %>
    <% if local_assigns.fetch(:linked, false) %>
      <%= link_to "View project", portfolio_item_path(item.id), class: "portfolio-view-link" %>
    <% end %>
  </div>
</article>
