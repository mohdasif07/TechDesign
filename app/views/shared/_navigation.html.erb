<header class="nav-wrap" data-nav>
  <nav class="nav container" aria-label="Main navigation">
    <%= link_to root_path, class: "brand", aria: { label: "Arqvexa home" } do %>
      <%= image_tag "/logo-mark.svg", alt: "", class: "brand-logo", width: 38, height: 38 %>
      <span class="brand-name">Arqvexa</span>
    <% end %>
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
    <div class="nav-links" id="nav-links">
      <%= nav_link interior_design_path, "Interior Design" %>
      <%= nav_link it_development_path, "IT Development" %>
      <%= nav_link portfolio_path, "Portfolio" %>
      <%= nav_link blog_path, "Blog" %>
      <%= nav_link about_path, "About" %>
      <%= nav_link contact_page_path, "Get a Quote", extra_class: "nav-cta" %>
    </div>
  </nav>
</header>
