<section class="section service-areas" id="service-areas">
  <div class="container">
    <div class="section-head compact reveal">
      <div>
        <div class="eyebrow"><span></span> Service Areas</div>
        <h2>Where we <em>work.</em></h2>
      </div>
      <p class="service-areas-intro">Arqvexa serves selected locations across Delhi NCR and Uttar Pradesh for interior design, and delivers web and software projects across India including Budaun, Bareilly and Aligarh.</p>
    </div>
    <div class="service-areas-grid reveal">
      <div class="service-areas-column">
        <h3 class="service-areas-title interior-label">Interior Design</h3>
        <ul class="service-area-links">
          <li><%= link_to "Interior Design in Delhi NCR", interior_design_path %></li>
          <% LocationPage.for_division(:interior).each do |page| %>
            <li><%= link_to "Interior Design in #{page.city}", page.path %></li>
          <% end %>
        </ul>
      </div>
      <div class="service-areas-column">
        <h3 class="service-areas-title tech-label">Web Development</h3>
        <ul class="service-area-links">
          <li><%= link_to "Web Development in India", it_development_path %></li>
          <% LocationPage.for_division(:web).each do |page| %>
            <li><%= link_to "Web Development in #{page.city}", page.path %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>
