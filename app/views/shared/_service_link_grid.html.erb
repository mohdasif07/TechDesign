<% variant = local_assigns.fetch(:variant, "default") %>
<div class="service-link-grid" data-variant="<%= variant %>">
  <% services.each_with_index do |service, index| %>
    <% delay_class = index.positive? ? " delay-#{[index, 6].min}" : nil %>
    <%= link_to service.path, class: ["service-link-card", "service-link-card--#{variant}", "reveal", delay_class].compact.join(" ").squeeze(" ") do %>
      <span class="service-link-icon" aria-hidden="true"><%= service_page_icon(service.slug, service.division) %></span>
      <strong class="service-link-title"><%= service.title %></strong>
      <span class="service-link-desc"><%= service.intro %></span>
      <span class="service-link-arrow" aria-hidden="true">Explore <span>→</span></span>
    <% end %>
  <% end %>
</div>
