<div class="founders founders-page reveal">
  <article class="founder-card founder-card--tech">
    <div class="founder-photo-wrap">
      <%= team_photo_tag "asif.jpg",
            alt: "Asif — Founder, Technology & Business at Arqvexa",
            class: "founder-photo",
            loading: "lazy",
            decoding: "async",
            width: 480,
            height: 540 %>
      <span class="founder-photo-badge">IT Development</span>
    </div>
    <div class="founder-body">
      <h2>Asif</h2>
      <p class="founder-role">Founder · Technology &amp; Business</p>
      <p>Asif leads Arqvexa's IT division — websites, web applications, mobile apps, CRM systems, AI chatbots and business software. He focuses on practical delivery: clear scope, maintainable code, SEO-ready marketing sites and tools teams actually use.</p>
      <%= link_to "Explore IT Development", it_development_path, class: "founder-link" %>
    </div>
  </article>

  <article class="founder-card founder-card--interior">
    <div class="founder-photo-wrap">
      <%= team_photo_tag "shalu.jpg",
            alt: "Shalu — Co-Founder, Interior Design at Arqvexa",
            class: "founder-photo",
            loading: "lazy",
            decoding: "async",
            width: 480,
            height: 540 %>
      <span class="founder-photo-badge">Interior Design</span>
    </div>
    <div class="founder-body">
      <h2>Shalu</h2>
      <p class="founder-role">Co-Founder · Interior Design</p>
      <p>Shalu leads interior design at Arqvexa — residential and commercial spaces, modular kitchens, wardrobes, 3D visualization and execution coordination across Delhi, Gurgaon and Noida.</p>
      <%= link_to "Explore Interior Design", interior_design_path, class: "founder-link" %>
    </div>
  </article>
</div>
