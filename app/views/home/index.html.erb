<% content_for :meta_title, "Arqvexa | Interior Design & IT Development in Delhi NCR" %>
<% content_for :meta_description, "Arqvexa — equal focus on interior design in Delhi NCR and IT development across India. Websites, apps, CRM, AI automation, modular kitchens, 3BHK design and more." %>
<% content_for :meta_keywords, "interior design Delhi NCR, web development Delhi, IT company Gurgaon, website design Noida, modular kitchen, mobile app development, interior designer near me" %>
<% content_for :canonical_url, request.base_url + root_path %>

<%= render "shared/navigation" %>

<main id="main-content">
  <section class="hero" id="home">
    <div class="hero-glow glow-one" aria-hidden="true"></div>
    <div class="hero-glow glow-two" aria-hidden="true"></div>
    <div class="container hero-grid hero-balanced">
      <div class="hero-copy reveal">
        <div class="eyebrow"><span></span> Delhi NCR • Remote India</div>
        <h1>Interior Design<br>&amp; <em>IT Development.</em><br>One Studio.</h1>
        <p class="hero-text">Whether you need a modular kitchen in Gurgaon or a business website that converts — Arqvexa delivers both with the same care and expertise.</p>
        <div class="hero-actions hero-actions-split">
          <%= link_to interior_design_path, class: "btn btn-primary" do %>
            Interior Design <span aria-hidden="true">→</span>
          <% end %>
          <%= link_to web_development_path, class: "btn btn-ghost" do %>
            IT Development <span aria-hidden="true">→</span>
          <% end %>
        </div>
        <div class="hero-proof">
          <div><strong>50/50</strong><span>Two Equal<br>Divisions</span></div>
          <div><strong>2</strong><span>Expert<br>Founders</span></div>
          <div><strong>∞</strong><span>Spaces &amp;<br>Software</span></div>
        </div>
      </div>

      <div class="hero-split-art reveal delay-1" aria-label="Interior design and IT development visuals">
        <div class="split-panel split-tech">
          <div class="split-label">IT Development</div>
          <div class="visual-digital compact">
            <div class="browser">
              <span></span><span></span><span></span>
              <div class="browser-title">Build. Ship. Scale.</div>
              <div class="browser-lines"></div>
              <div class="code-snippet">
                <span class="code-kw">const</span> app = <span class="code-fn">launch</span>();
              </div>
            </div>
          </div>
        </div>
        <div class="split-panel split-interior">
          <div class="split-label">Interior Design</div>
          <div class="mini-room">
            <div class="wall"></div><div class="floor"></div><div class="window"></div>
            <div class="sofa"></div><div class="table"></div>
            <div class="plant"><i></i><i></i><i></i></div>
          </div>
        </div>
        <div class="split-connector">×</div>
      </div>
    </div>
  </section>

  <section class="path-selector">
    <div class="container path-grid reveal">
      <%= link_to interior_design_path, class: "path-card path-interior" do %>
        <span class="path-icon" aria-hidden="true">⌂</span>
        <h2>Interior Design</h2>
        <p>Homes, offices, modular kitchens, 3D plans and full execution in Delhi NCR.</p>
        <span class="path-link">Explore interiors <span aria-hidden="true">→</span></span>
      <% end %>
      <%= link_to web_development_path, class: "path-card path-tech" do %>
        <span class="path-icon" aria-hidden="true">&lt;/&gt;</span>
        <h2>IT Development</h2>
        <p>Websites, mobile apps, e-commerce, CRM, AI chatbots and custom software.</p>
        <span class="path-link">Explore technology <span aria-hidden="true">→</span></span>
      <% end %>
    </div>
  </section>

  <div class="trust-bar" aria-label="Capabilities">
    <div class="container trust-inner">
      <span>Web Development</span>
      <span>Interior Design</span>
      <span>Mobile Apps</span>
      <span>Modular Kitchen</span>
      <span>E-commerce</span>
      <span>3BHK Design</span>
      <span>CRM &amp; AI</span>
      <span>Office Interiors</span>
    </div>
  </div>

  <section class="section services" id="services">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow"><span></span> What we do</div>
          <h2>Two divisions.<br><em>Equal focus.</em></h2>
        </div>
        <p>Interior design and IT development are both core to Arqvexa — not add-ons. Pick one, or combine both for a unified brand and space.</p>
      </div>

      <div class="service-grid">
        <article class="service-card interior reveal">
          <div class="service-icon" aria-hidden="true">⌂</div>
          <div class="service-no">01</div>
          <h3>Interior Design</h3>
          <p>Beautiful, functional spaces designed around your lifestyle, brand and budget.</p>
          <ul>
            <li>2D Planning &amp; Layouts</li>
            <li>3D Visualization</li>
            <li>Residential &amp; Commercial</li>
            <li>Modular Kitchen &amp; Wardrobes</li>
            <li>Execution &amp; Vendor Coordination</li>
          </ul>
          <%= link_to interior_design_path do %>View interior services <span aria-hidden="true">→</span><% end %>
        </article>

        <article class="service-card tech reveal delay-1">
          <div class="service-icon" aria-hidden="true">&lt;/&gt;</div>
          <div class="service-no">02</div>
          <h3>IT Development</h3>
          <p>Digital products and automation that help businesses look better and work smarter.</p>
          <ul>
            <li>Websites &amp; E-commerce</li>
            <li>Web &amp; Mobile Applications</li>
            <li>AI Chatbots &amp; Automation</li>
            <li>CRM &amp; Custom Software</li>
            <li>API Integration &amp; Support</li>
          </ul>
          <%= link_to web_development_path do %>View IT services <span aria-hidden="true">→</span><% end %>
        </article>
      </div>
    </div>
  </section>

  <%= render "shared/portfolio_section" %>

  <%= render "shared/pricing_section" %>

  <section class="section about" id="about">
    <div class="container about-grid">
      <div class="about-badge reveal">
        <div class="badge-ring">AV</div>
        <span>Founded by<br><strong>Asif &amp; Shalu</strong></span>
      </div>
      <div class="reveal delay-1">
        <div class="eyebrow"><span></span> About Arqvexa</div>
        <h2>Two founders.<br><em>Two equal strengths.</em></h2>
        <p>Arqvexa is built on a simple idea: interior design and IT development deserve the same level of craft. Neither is secondary.</p>
        <p><strong>Asif</strong> leads technology — websites, apps, CRM, AI and business software. <strong>Shalu</strong> leads interior design — residential, commercial, 3D visualization and execution. Together, clients get one team for spaces and software.</p>
        <div class="founders">
          <div><strong>Asif</strong><span>Founder · IT Development &amp; Business</span></div>
          <div><strong>Shalu</strong><span>Co-Founder · Interior Design</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section process" id="process">
    <div class="container">
      <div class="section-head compact reveal">
        <div><div class="eyebrow"><span></span> How we work</div><h2>Simple. Clear. <em>Collaborative.</em></h2></div>
      </div>
      <div class="steps">
        <div class="step reveal"><span>01</span><h3>Discover</h3><p>We understand your goals — whether that's a floor plan or a product roadmap.</p></div>
        <div class="step reveal delay-1"><span>02</span><h3>Design</h3><p>3D layouts, wireframes, prototypes and clear proposals before build.</p></div>
        <div class="step reveal delay-2"><span>03</span><h3>Build</h3><p>Development sprints or on-site execution — always with regular updates.</p></div>
        <div class="step reveal delay-3"><span>04</span><h3>Deliver</h3><p>Handover of your space or software, ready to use and easy to maintain.</p></div>
      </div>
    </div>
  </section>

  <section class="section testimonials" id="testimonials">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> Client trust</div>
          <h2>Trusted for <em>both.</em></h2>
        </div>
      </div>
      <div class="testimonial-grid testimonial-grid-4">
        <blockquote class="testimonial-card reveal">
          <p>"Our new site loads fast, looks professional on mobile, and actually brings in enquiries."</p>
          <footer><strong>Small Business Owner</strong><span>IT Development · Remote</span></footer>
        </blockquote>
        <blockquote class="testimonial-card reveal delay-1">
          <p>"The CRM they built cut our follow-up time in half. Clean dashboard, exactly what we needed."</p>
          <footer><strong>Operations Manager</strong><span>IT Development · Delhi</span></footer>
        </blockquote>
        <blockquote class="testimonial-card reveal delay-2">
          <p>"Clear process from 3D layout to final execution. Every detail was thought through before we started."</p>
          <footer><strong>Homeowner</strong><span>Interior Design · Gurgaon</span></footer>
        </blockquote>
        <blockquote class="testimonial-card reveal delay-3">
          <p>"One team for both our office redesign and company website — saved time and kept the vision consistent."</p>
          <footer><strong>Startup Founder</strong><span>Both · Delhi NCR</span></footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> FAQ</div>
          <h2>Questions by <em>service.</em></h2>
        </div>
        <p class="faq-intro">Find answers for interior design and IT development. More detail on each service page.</p>
      </div>
      <div class="faq-columns reveal">
        <div class="faq-column">
          <h3 class="faq-column-title interior-label">⌂ Interior Design</h3>
          <div class="faq-list">
            <details class="faq-item">
              <summary>Which areas do you serve for interior projects?</summary>
              <p>We focus on Delhi NCR — Delhi, Gurgaon, Noida and nearby — for site visits, measurements and execution coordination.</p>
            </details>
            <details class="faq-item">
              <summary>Do you provide 3D visualizations before construction?</summary>
              <p>Yes. Every interior project includes layout planning and 3D views so you approve the design before work begins.</p>
            </details>
            <details class="faq-item">
              <summary>Can you design modular kitchens and wardrobes?</summary>
              <p>Yes. Modular kitchen and wardrobe design is a core offering, with material and finish options to match your budget.</p>
            </details>
            <details class="faq-item">
              <summary>Do you handle execution and vendors?</summary>
              <p>We coordinate with trusted vendors and contractors so the finished space matches the approved design.</p>
            </details>
          </div>
          <%= link_to "More interior FAQs →", interior_design_path(anchor: "faq"), class: "faq-page-link" %>
        </div>
        <div class="faq-column">
          <h3 class="faq-column-title tech-label">&lt;/&gt; IT Development</h3>
          <div class="faq-list">
            <details class="faq-item">
              <summary>Do you work with clients outside Delhi NCR?</summary>
              <p>Yes. IT projects are delivered remotely across India and internationally — discovery calls, demos and support are all online.</p>
            </details>
            <details class="faq-item">
              <summary>What IT services do you offer?</summary>
              <p>Websites, e-commerce stores, web and mobile apps, CRM systems, AI chatbots, API integrations and ongoing support.</p>
            </details>
            <details class="faq-item">
              <summary>How long does a website or app take?</summary>
              <p>A business website typically takes 2–4 weeks. Apps and custom software depend on scope — we give a clear timeline after discovery.</p>
            </details>
            <details class="faq-item">
              <summary>Do you provide maintenance after launch?</summary>
              <p>Yes. We offer support plans for updates, hosting guidance, bug fixes and feature additions after go-live.</p>
            </details>
          </div>
          <%= link_to "More IT FAQs →", web_development_path(anchor: "faq"), class: "faq-page-link" %>
        </div>
      </div>
    </div>
  </section>

  <%= render "shared/blog_preview" %>

  <section class="cta-section" id="contact">
    <div class="container cta-box">
      <div class="reveal">
        <div class="eyebrow"><span></span> Start a conversation</div>
        <h2>Interior or IT —<br><em>let's talk.</em></h2>
        <p>Tell us about your space, website, app or software idea. We'll reply with clear next steps within 24 hours.</p>
        <ul class="contact-details">
          <li><span>Interior</span> Delhi NCR · On-site visits</li>
          <li><span>IT</span> India &amp; remote · Video calls</li>
          <li><span>Email</span> mohdasif.dev01@gmail.com</li>
        </ul>
      </div>
      <%= render "shared/contact_panel", return_to: root_path(anchor: "contact") %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
