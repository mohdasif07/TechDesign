<% seo_page(
  title: "Arqvexa | Interior Design & IT Development in Delhi NCR",
  description: "Arqvexa provides interior design services across Delhi NCR and web, mobile, AI and custom software development for businesses across India.",
  canonical: site_url("/"),
  keywords: "interior design Delhi NCR, web development Delhi, IT company Gurgaon, website design Noida, modular kitchen, mobile app development, interior designer near me"
) %>
<% content_for :division, "studio" %>
<% content_for :body_class, "page-home" %>

<%= render "shared/navigation" %>

<main id="main-content">
  <section class="hero hero-immersive hero-split" id="home" data-hero-split>
    <div class="hero-split-bg" aria-hidden="true">
      <div class="hero-waves" data-hero-waves>
        <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="waveGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#C9A87C" stop-opacity="0.35"/>
              <stop offset="45%" stop-color="#00D9FF" stop-opacity="0.4"/>
              <stop offset="100%" stop-color="#7C3AED" stop-opacity="0.35"/>
            </linearGradient>
            <filter id="waveBlur">
              <feGaussianBlur stdDeviation="28"/>
            </filter>
          </defs>
          <path class="wave-path" fill="url(#waveGrad)" filter="url(#waveBlur)" d="M0,400 C240,280 480,520 720,400 C960,280 1200,520 1440,380 L1440,900 L0,900 Z"/>
          <path class="wave-path wave-path--2" fill="url(#waveGrad)" filter="url(#waveBlur)" opacity="0.5" d="M0,520 C300,400 540,640 780,520 C1020,400 1260,620 1440,500 L1440,900 L0,900 Z"/>
        </svg>
      </div>
    </div>

    <div class="hero-split-panels" aria-hidden="true">
      <div class="hero-panel hero-panel-interior">
        <div class="hero-panel-media" role="img" aria-label="Cinematic interior design photography"></div>
        <div class="hero-panel-overlay"></div>
        <span class="hero-panel-label">Spaces</span>
      </div>
      <div class="hero-panel hero-panel-tech">
        <div class="hero-panel-media"></div>
        <div class="hero-panel-overlay"></div>
        <div class="digital-network">
          <svg viewBox="0 0 400 600" preserveAspectRatio="xMidYMid slice">
            <g stroke="rgba(0,217,255,0.35)" stroke-width="1" fill="none">
              <circle cx="80" cy="120" r="3" fill="#00D9FF"/>
              <circle cx="200" cy="80" r="3" fill="#4267FF"/>
              <circle cx="320" cy="140" r="3" fill="#7C3AED"/>
              <circle cx="140" cy="280" r="3" fill="#00D9FF"/>
              <circle cx="280" cy="320" r="3" fill="#4267FF"/>
              <circle cx="200" cy="420" r="3" fill="#7C3AED"/>
              <path d="M80 120 L200 80 L320 140 M200 80 L140 280 M320 140 L280 320 M140 280 L200 420 L280 320"/>
            </g>
          </svg>
        </div>
        <span class="hero-panel-label">Systems</span>
      </div>
    </div>

    <div class="hero-split-center" aria-hidden="true"></div>

    <div class="hero-split-content">
      <div class="eyebrow reveal"><span></span> Delhi NCR • Remote India</div>
      <h1 class="reveal delay-1">Interior Design<br><span class="hero-amp">&amp;</span><br>IT Development.<br>One Studio.</h1>
      <p class="hero-subhead reveal delay-2"><strong>Spaces for people.</strong><br>Systems for business.</p>
      <p class="hero-text reveal delay-2">Whether you need a modular kitchen in Gurgaon or a business website that converts — Arqvexa delivers both with the same care and expertise.</p>
      <div class="hero-actions hero-actions-split reveal delay-3">
        <%= link_to interior_design_path, class: "btn btn-primary", data: { magnetic: true } do %>
          Interior Design <span aria-hidden="true">→</span>
        <% end %>
        <%= link_to it_development_path, class: "btn btn-ghost", data: { magnetic: true } do %>
          IT Development <span aria-hidden="true">→</span>
        <% end %>
      </div>
      <div class="hero-proof reveal delay-4">
        <div><strong>50/50</strong><span>Two Equal<br>Divisions</span></div>
        <div><strong>2</strong><span>Expert<br>Founders</span></div>
        <div><strong>∞</strong><span>Spaces &amp;<br>Software</span></div>
      </div>
    </div>

    <div class="hero-scroll-cue reveal delay-5" aria-hidden="true">
      <span>Scroll to explore</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <section class="path-selector">
    <div class="container path-grid reveal">
      <%= link_to interior_design_path, class: "path-card path-interior", data: { tilt_card: true } do %>
        <span class="path-icon" aria-hidden="true">⌂</span>
        <h2>Interior Design</h2>
        <p>Homes, offices, modular kitchens, 3D plans and full execution in Delhi NCR.</p>
        <span class="path-link">Explore interiors <span aria-hidden="true">→</span></span>
      <% end %>
      <%= link_to it_development_path, class: "path-card path-tech", data: { tilt_card: true } do %>
        <%= render "shared/icon_tech" %>
        <h2>IT Development</h2>
        <p>Websites, mobile apps, e-commerce, CRM, AI chatbots and custom software.</p>
        <span class="path-link">Explore technology <span aria-hidden="true">→</span></span>
      <% end %>
    </div>
  </section>

  <div class="trust-bar" aria-label="Capabilities">
    <div class="container trust-inner">
      <span>Web Development</span>
      <span>Interior Design</span>
      <span>Mobile Apps</span>
      <span>Modular Kitchen</span>
      <span>E-commerce</span>
      <span>3BHK Design</span>
      <span>CRM &amp; AI</span>
      <span>Office Interiors</span>
    </div>
  </div>

  <%# Two Worlds — immersive scroll storytelling %>
  <section class="worlds-section" id="two-worlds" aria-label="Interior Design and IT Development experiences">
    <div class="world-block world-block-interior" data-world="interior">
      <div class="arch-grid" aria-hidden="true"></div>
      <div class="container world-grid">
        <div class="world-copy reveal">
          <div class="eyebrow"><span></span> Interior Design</div>
          <h2>Spaces designed around how you live.</h2>
          <p>From floor plan to finished room — layouts, materials, lighting and execution across Delhi NCR.</p>
          <div class="world-links">
            <%= link_to "Residential", interior_service_path("residential-interior-design") %>
            <%= link_to "Modular Kitchen", interior_service_path("modular-kitchen") %>
            <%= link_to "Office", interior_service_path("office-interior-design") %>
            <%= link_to "3D Visualization", interior_service_path("3d-visualization") %>
          </div>
          <div class="hero-actions" style="margin-top: 28px;">
            <%= link_to interior_design_path, class: "btn btn-primary" do %>
              Explore Interior Design <span aria-hidden="true">→</span>
            <% end %>
          </div>
        </div>
        <div class="reveal delay-1">
          <div class="world-stages" data-world-stages="interior">
            <div class="world-stage is-active" data-stage="0"
                 style="background-image: linear-gradient(180deg,rgba(5,8,22,.2),rgba(5,8,22,.55)), url('/portfolio/modern-3bhk-gurgaon/bedroom-minimal-white.webp');"
                 role="img" aria-label="Floor plan inspired interior layout"></div>
            <div class="world-stage" data-stage="1"
                 style="background-image: linear-gradient(180deg,rgba(5,8,22,.15),rgba(5,8,22,.5)), url('/portfolio/modern-office-noida/minimal-open-office.webp');"
                 role="img" aria-label="3D interior visualization"></div>
            <div class="world-stage" data-stage="2"
                 style="background-image: linear-gradient(180deg,rgba(5,8,22,.1),rgba(5,8,22,.45)), url('/portfolio/contemporary-kitchen-delhi/marble-luxury-integrated.webp');"
                 role="img" aria-label="Finished interior living space"></div>
            <span class="world-stage-caption" data-stage-caption>Floor plan → 3D → Finished</span>
          </div>
          <div class="world-progress" role="tablist" aria-label="Interior design stages">
            <button type="button" class="is-active" data-stage-btn="0" aria-label="Floor plan stage"></button>
            <button type="button" data-stage-btn="1" aria-label="3D visualization stage"></button>
            <button type="button" data-stage-btn="2" aria-label="Finished interior stage"></button>
          </div>
        </div>
      </div>
    </div>

    <div class="container" style="padding: 20px 0;">
      <%= render "shared/signature_line" %>
    </div>

    <div class="world-block world-block-tech" data-world="tech">
      <div class="container world-grid">
        <div class="reveal">
          <div class="world-stages" data-world-stages="tech">
            <div class="world-stage is-active" data-stage="0"
                 style="background: linear-gradient(145deg,#0a1228,#142050);">
              <div class="digital-network" style="opacity:1;position:absolute;inset:0;">
                <svg viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice">
                  <g stroke="rgba(0,217,255,0.4)" fill="none" stroke-width="1.2">
                    <circle cx="100" cy="80" r="5" fill="#00D9FF"/><text x="115" y="85" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">Website</text>
                    <circle cx="300" cy="60" r="5" fill="#4267FF"/><text x="315" y="65" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">API</text>
                    <circle cx="480" cy="100" r="5" fill="#7C3AED"/><text x="420" y="120" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">CRM</text>
                    <circle cx="160" cy="220" r="5" fill="#00D9FF"/><text x="175" y="225" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">Database</text>
                    <circle cx="360" cy="240" r="5" fill="#4267FF"/><text x="375" y="245" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">AI</text>
                    <circle cx="280" cy="360" r="5" fill="#7C3AED"/><text x="295" y="365" fill="#A7ADBD" font-size="11" font-family="Outfit,sans-serif">Mobile App</text>
                    <path d="M100 80 L300 60 L480 100 M300 60 L160 220 M300 60 L360 240 M160 220 L280 360 L360 240 L480 100"/>
                  </g>
                </svg>
              </div>
            </div>
            <div class="world-stage" data-stage="1"
                 style="background: linear-gradient(160deg,#081020 0%,#101838 50%,#1a1040 100%);">
              <div style="position:absolute;inset:12%;border:1px solid rgba(0,217,255,.25);border-radius:12px;background:rgba(5,8,22,.6);padding:16px;">
                <div style="height:10px;width:40%;background:rgba(0,217,255,.35);border-radius:4px;margin-bottom:12px;"></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                  <div style="height:60px;background:rgba(66,103,255,.2);border-radius:8px;"></div>
                  <div style="height:60px;background:rgba(124,58,237,.2);border-radius:8px;"></div>
                  <div style="height:60px;background:rgba(0,217,255,.15);border-radius:8px;grid-column:span 2;"></div>
                </div>
              </div>
            </div>
            <div class="world-stage" data-stage="2"
                 style="background: radial-gradient(circle at 30% 30%,rgba(0,217,255,.2),transparent 50%),linear-gradient(145deg,#050816,#0C1638);">
              <div style="position:absolute;inset:10%;display:grid;place-items:center;text-align:center;">
                <div>
                  <div style="font:700 28px Syne,sans-serif;background:linear-gradient(135deg,#00D9FF,#7C3AED);-webkit-background-clip:text;background-clip:text;color:transparent;">BUILD. SHIP. SCALE.</div>
                  <p style="color:#A7ADBD;font-size:14px;margin-top:12px;">Finished digital product</p>
                </div>
              </div>
            </div>
            <span class="world-stage-caption" data-stage-caption>Wireframe → Interface → Product</span>
          </div>
          <div class="world-progress" role="tablist" aria-label="IT development stages">
            <button type="button" class="is-active" data-stage-btn="0" aria-label="System network stage"></button>
            <button type="button" data-stage-btn="1" aria-label="Interface stage"></button>
            <button type="button" data-stage-btn="2" aria-label="Finished product stage"></button>
          </div>
        </div>
        <div class="world-copy reveal delay-1">
          <div class="eyebrow"><span></span> IT Development</div>
          <h2>Digital products designed around how your business works.</h2>
          <p>Websites, dashboards, mobile apps, CRM and AI — wired into one coherent system.</p>
          <div class="world-links">
            <%= link_to "Web", it_service_path("web-development") %>
            <%= link_to "E-commerce", it_service_path("ecommerce-development") %>
            <%= link_to "Mobile Apps", it_service_path("mobile-app-development") %>
            <%= link_to "AI", it_service_path("ai-development") %>
            <%= link_to "CRM", it_service_path("crm-development") %>
          </div>
          <div class="hero-actions" style="margin-top: 28px;">
            <%= link_to it_development_path, class: "btn btn-primary" do %>
              Explore IT Development <span aria-hidden="true">→</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section services" id="services">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow"><span></span> What we do</div>
          <h2>Two divisions.<br><em>Equal focus.</em></h2>
        </div>
        <p>Interior design and IT development are both core to Arqvexa — not add-ons. Pick one, or combine both for a unified brand and space.</p>
      </div>

      <div class="service-grid">
        <article class="service-card interior reveal">
          <div class="service-icon" aria-hidden="true">⌂</div>
          <div class="service-no">01</div>
          <h3>Interior Design</h3>
          <p>Beautiful, functional spaces designed around your lifestyle, brand and budget.</p>
          <ul>
            <li>2D Planning &amp; Layouts</li>
            <li>3D Visualization</li>
            <li>Residential &amp; Commercial</li>
            <li>Modular Kitchen &amp; Wardrobes</li>
            <li>Execution &amp; Vendor Coordination</li>
          </ul>
          <%= link_to interior_design_path do %>View interior services <span aria-hidden="true">→</span><% end %>
        </article>

        <article class="service-card tech reveal delay-1">
          <div class="service-icon icon-tech-wrap" aria-hidden="true"><%= render "shared/icon_tech" %></div>
          <div class="service-no">02</div>
          <h3>IT Development</h3>
          <p>Digital products and automation that help businesses look better and work smarter.</p>
          <ul>
            <li>Websites &amp; E-commerce</li>
            <li>Web &amp; Mobile Applications</li>
            <li>AI Chatbots &amp; Automation</li>
            <li>CRM &amp; Custom Software</li>
            <li>API Integration &amp; Support</li>
          </ul>
          <%= link_to it_development_path do %>View IT services <span aria-hidden="true">→</span><% end %>
        </article>
      </div>
    </div>
  </section>

  <%= render "shared/portfolio_section" %>

  <%= render "shared/pricing_section" %>

  <section class="section about" id="about">
    <div class="container about-grid">
      <div class="about-badge reveal">
        <div class="badge-ring">AV</div>
        <span>Founded by<br><strong>Asif &amp; Shalu</strong></span>
      </div>
      <div class="reveal delay-1">
        <div class="eyebrow"><span></span> About Arqvexa</div>
        <h2>Two founders.<br><em>Two equal strengths.</em></h2>
        <p>Arqvexa is built on a simple idea: interior design and IT development deserve the same level of craft. Neither is secondary.</p>
        <p><strong>Asif</strong> leads technology — websites, apps, CRM, AI and business software. <strong>Shalu</strong> leads interior design — residential, commercial, 3D visualization and execution. Together, clients get one team for spaces and software.</p>
        <div class="founders">
          <div><strong>Asif</strong><span>Founder · IT Development &amp; Business</span></div>
          <div><strong>Shalu</strong><span>Co-Founder · Interior Design</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section process" id="process">
    <div class="container">
      <div class="section-head compact reveal">
        <div><div class="eyebrow"><span></span> How we work</div><h2>Simple. Clear. <em>Collaborative.</em></h2></div>
      </div>
      <div class="steps">
        <div class="step reveal"><span>01</span><h3>Discover</h3><p>We understand your goals — whether that's a floor plan or a product roadmap.</p></div>
        <div class="step reveal delay-1"><span>02</span><h3>Design</h3><p>3D layouts, wireframes, prototypes and clear proposals before build.</p></div>
        <div class="step reveal delay-2"><span>03</span><h3>Build</h3><p>Development sprints or on-site execution — always with regular updates.</p></div>
        <div class="step reveal delay-3"><span>04</span><h3>Deliver</h3><p>Handover of your space or software, ready to use and easy to maintain.</p></div>
      </div>
    </div>
  </section>

  <section class="section trust-signals" id="trust">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> Why Arqvexa</div>
          <h2>One studio. <em>Two strengths.</em></h2>
        </div>
        <p>Clear process, honest scoping and dedicated divisions for interiors and technology — without treating either as an add-on.</p>
      </div>
      <div class="trust-signal-grid reveal">
        <article class="trust-signal-card">
          <h3>Interior · Delhi NCR</h3>
          <p>Site visits, 2D layouts, 3D visualization and execution support across Delhi, Gurgaon and Noida.</p>
          <%= link_to "Interior services", interior_design_path %>
        </article>
        <article class="trust-signal-card">
          <h3>IT · India &amp; remote</h3>
          <p>Websites, apps, e-commerce, CRM and AI automation with discovery-led delivery and regular demos.</p>
          <%= link_to "IT services", it_development_path %>
        </article>
        <article class="trust-signal-card">
          <h3>Transparent process</h3>
          <p>Discovery, design, build and handover — with milestones you can track whether the project is a home or a product.</p>
          <%= link_to "About Arqvexa", about_path %>
        </article>
        <article class="trust-signal-card">
          <h3>Direct contact</h3>
          <p>Reach us by form, email or WhatsApp. We reply within 24 hours with next steps.</p>
          <%= link_to "Get a quote", contact_page_path %>
        </article>
      </div>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> FAQ</div>
          <h2>Questions by <em>service.</em></h2>
        </div>
        <p class="faq-intro">Find answers for interior design and IT development. More detail on each service page.</p>
      </div>
      <div class="faq-columns reveal">
        <div class="faq-column">
          <h3 class="faq-column-title interior-label">⌂ Interior Design</h3>
          <div class="faq-list">
            <details class="faq-item">
              <summary>Which areas do you serve for interior projects?</summary>
              <p>We serve Delhi NCR — Delhi, Gurgaon, Noida and nearby — for site visits and execution. We also serve Budaun, Bareilly and Aligarh in Uttar Pradesh as expanded service areas.</p>
            </details>
            <details class="faq-item">
              <summary>Do you provide 3D visualizations before construction?</summary>
              <p>Yes. Every interior project includes layout planning and 3D views so you approve the design before work begins.</p>
            </details>
            <details class="faq-item">
              <summary>Can you design modular kitchens and wardrobes?</summary>
              <p>Yes. Modular kitchen and wardrobe design is a core offering, with material and finish options to match your budget.</p>
            </details>
            <details class="faq-item">
              <summary>Do you handle execution and vendors?</summary>
              <p>We coordinate with trusted vendors and contractors so the finished space matches the approved design.</p>
            </details>
          </div>
          <%= link_to "More interior FAQs →", interior_design_path(anchor: "faq"), class: "faq-page-link" %>
        </div>
        <div class="faq-column">
          <h3 class="faq-column-title tech-label">IT Development</h3>
          <div class="faq-list">
            <details class="faq-item">
              <summary>Do you work with clients outside Delhi NCR?</summary>
              <p>Yes. IT projects are delivered remotely across India and internationally — discovery calls, demos and support are all online.</p>
            </details>
            <details class="faq-item">
              <summary>What IT services do you offer?</summary>
              <p>Websites, e-commerce stores, web and mobile apps, CRM systems, AI chatbots, API integrations and ongoing support.</p>
            </details>
            <details class="faq-item">
              <summary>How long does a website or app take?</summary>
              <p>A business website typically takes 2–4 weeks. Apps and custom software depend on scope — we give a clear timeline after discovery.</p>
            </details>
            <details class="faq-item">
              <summary>Do you provide maintenance after launch?</summary>
              <p>Yes. We offer support plans for updates, hosting guidance, bug fixes and feature additions after go-live.</p>
            </details>
          </div>
          <%= link_to "More IT FAQs →", it_development_path(anchor: "faq"), class: "faq-page-link" %>
        </div>
      </div>
    </div>
  </section>

  <%= render "shared/blog_preview" %>

  <section class="section content-block">
    <div class="container content-prose reveal">
      <div class="eyebrow"><span></span> Service Areas</div>
      <h2>Interior Design &amp; Digital Solutions Across Delhi NCR and Uttar Pradesh</h2>
      <p>Arqvexa provides interior design and digital development solutions for homes and businesses across selected locations in Delhi NCR and Uttar Pradesh. Our service areas include Delhi NCR, Budaun, Bareilly and Aligarh.</p>
      <p>For interior projects, we combine site visits and execution coordination in Delhi NCR with planned visits to Uttar Pradesh cities. For web and software projects, we deliver remotely with the same structured process used for clients across India.</p>
    </div>
  </section>

  <%= render "shared/service_areas" %>

  <section class="cta-section" id="contact">
    <div class="container cta-box">
      <div class="reveal">
        <div class="eyebrow"><span></span> Start a conversation</div>
        <h2>Interior or IT —<br><em>let's talk.</em></h2>
        <p>Tell us about your space, website, app or software idea. We'll reply with clear next steps within 24 hours.</p>
        <ul class="contact-details">
          <li><span>Interior</span> Delhi NCR · On-site visits</li>
          <li><span>IT</span> India &amp; remote · Video calls</li>
          <li><span>Email</span> <%= contact_email_link %></li>
          <li><span>Phone</span> <%= link_to contact_phone_display, "tel:#{contact_phone_tel}" %></li>
          <li><span>WhatsApp</span> <%= link_to contact_phone_display, "https://wa.me/919917639330", target: "_blank", rel: "noopener noreferrer" %></li>
        </ul>
      </div>
      <%= render "shared/contact_panel", return_to: root_path(anchor: "contact") %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
