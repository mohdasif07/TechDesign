<% seo_page(
  title: "Interior Design & IT Portfolio | Arqvexa",
  description: "Explore Arqvexa interior design projects and IT development work including websites, software, integrations, warehouse platforms and digital products.",
  canonical: site_url(portfolio_path),
  keywords: "Arqvexa portfolio, interior design projects Delhi NCR, IT development case studies, website portfolio, software projects India, modular kitchen projects",
  robots: (@category == "all" ? nil : "noindex, follow")
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "Portfolio", url: site_url(portfolio_path) }
) %>

<% content_for :structured_data do %>
  <%= json_ld_script(breadcrumb_schema(breadcrumb_items)) %>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content" class="page-main">
  <%= render_breadcrumbs %>

  <section class="page-hero page-hero-light">
    <div class="container">
      <div class="eyebrow"><span></span> Portfolio</div>
      <h1>Our <em>work.</em></h1>
      <p class="page-lead">Enterprise software, warehouse platforms, ERP integrations, and interior concept work — filter by division or browse everything.</p>
    </div>
  </section>

  <section class="section portfolio-page" data-portfolio-filter>
    <div class="container">
      <div class="portfolio-filters reveal" role="tablist" aria-label="Filter portfolio">
        <%= link_to "All",
              portfolio_path,
              class: ["portfolio-filter", ("is-active" if @category == "all")].compact.join(" "),
              role: "tab",
              aria: { selected: (@category == "all").to_s } %>
        <%= link_to "Interior",
              portfolio_path(category: "interior"),
              class: ["portfolio-filter", ("is-active" if @category == "interior")].compact.join(" "),
              role: "tab",
              aria: { selected: (@category == "interior").to_s } %>
        <%= link_to "IT Development",
              portfolio_path(category: "tech"),
              class: ["portfolio-filter", ("is-active" if @category == "tech")].compact.join(" "),
              role: "tab",
              aria: { selected: (@category == "tech").to_s } %>
      </div>

      <div class="work-grid work-grid-3 portfolio-grid reveal">
        <% @filtered_items.each do |item| %>
          <%= render "shared/portfolio_card", item: item, linked: true %>
        <% end %>
      </div>

      <% if @filtered_items.empty? %>
        <p class="portfolio-empty">No projects in this category yet.</p>
      <% end %>
    </div>
  </section>

  <section class="section cta-inline">
    <div class="container">
      <%= render "shared/cta_banner",
            title: "Have a similar project in mind?",
            button_label: "Start a conversation",
            button_url: contact_page_path(anchor: "contact") %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
