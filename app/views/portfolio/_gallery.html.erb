<% slides = Array(local_assigns.fetch(:slides)) %>
<section class="portfolio-gallery reveal" data-portfolio-gallery aria-label="Project photo gallery" tabindex="0">
  <div class="portfolio-gallery-main">
    <div class="portfolio-gallery-progress" aria-hidden="true">
      <span class="portfolio-gallery-progress-bar" data-gallery-progress></span>
    </div>

    <% if slides.size > 1 %>
      <div class="portfolio-gallery-meta">
        <span class="portfolio-gallery-counter" data-gallery-counter>1 / <%= slides.size %></span>
      </div>
    <% end %>

    <div class="portfolio-gallery-track">
      <% slides.each_with_index do |slide, index| %>
        <figure class="portfolio-gallery-slide<%= " is-active" if index.zero? %>" data-slide="<%= index %>">
          <%= portfolio_picture_tag slide["image"],
                alt: slide["alt"],
                class: "portfolio-gallery-image",
                loading: index.zero? ? "eager" : "lazy",
                fetchpriority: index.zero? ? "high" : "auto" %>
          <% if slide["caption"].present? %>
            <figcaption class="portfolio-gallery-caption">
              <span class="portfolio-gallery-caption-text"><%= slide["caption"] %></span>
            </figcaption>
          <% end %>
        </figure>
      <% end %>
    </div>

    <% if slides.size > 1 %>
      <button type="button" class="portfolio-gallery-nav portfolio-gallery-prev" aria-label="Previous photo" data-gallery-prev>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="portfolio-gallery-nav portfolio-gallery-next" aria-label="Next photo" data-gallery-next>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="portfolio-gallery-dots" role="tablist" aria-label="Gallery slides">
        <% slides.each_with_index do |slide, index| %>
          <button type="button"
                  class="portfolio-gallery-dot<%= " is-active" if index.zero? %>"
                  role="tab"
                  aria-selected="<%= index.zero? %>"
                  aria-label="Show photo <%= index + 1 %> of <%= slides.size %>"
                  data-gallery-dot="<%= index %>"></button>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if slides.size > 1 %>
    <div class="portfolio-gallery-thumbs" role="list" aria-label="Gallery thumbnails">
      <% slides.each_with_index do |slide, index| %>
        <button type="button"
                class="portfolio-gallery-thumb<%= " is-active" if index.zero? %>"
                data-gallery-thumb="<%= index %>"
                role="listitem"
                aria-label="View <%= slide["caption"].presence || "photo #{index + 1}" %>">
          <%= portfolio_picture_tag slide["image"], alt: "", variant: :thumb %>
          <span class="portfolio-gallery-thumb-index"><%= index + 1 %></span>
        </button>
      <% end %>
    </div>
  <% end %>
</section>
