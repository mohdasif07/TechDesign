<% seo_page(
  title: "Interior Design & IT Development Blog | Arqvexa",
  description: "Practical guides on interior design, modular kitchens, website development, mobile apps, AI, software and technology.",
  canonical: site_url(blog_path)
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "Blog", url: site_url(blog_path) }
) %>

<% content_for :structured_data do %>
  <%= json_ld_script(breadcrumb_schema(breadcrumb_items)) %>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content" class="page-main">
  <%= render_breadcrumbs %>

  <section class="page-hero page-hero-light">
    <div class="container">
      <div class="eyebrow"><span></span> Blog</div>
      <%= render "shared/brand_signature", class_name: "brand-signature--stacked" %>
      <h1>Insights on <em>spaces &amp; software.</em></h1>
      <p class="page-lead">Guides for homeowners and businesses in Delhi NCR — interior design tips, website costs and project timelines.</p>
    </div>
  </section>

  <section class="section">
    <div class="container blog-list">
      <% @posts.each do |post| %>
        <article class="blog-list-item reveal">
          <span class="blog-category <%= post.interior? ? "interior-label" : "tech-label" %>"><%= post.category_label %></span>
          <h2><%= link_to post.title, blog_post_path(post.slug) %></h2>
          <p><%= post.excerpt %></p>
          <div class="blog-meta">
            <time datetime="<%= post.published_at %>"><%= post.formatted_date %></time>
            <span><%= post.read_time %></span>
          </div>
          <%= link_to "Read article →", blog_post_path(post.slug), class: "blog-read-link" %>
        </article>
      <% end %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
