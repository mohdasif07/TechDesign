<% content_for :meta_title, "#{@post.title} | Arqvexa Blog" %>
<% content_for :meta_description, @post.excerpt %>
<% content_for :canonical_url, site_url(blog_post_path(@post.slug)) %>

<% content_for :structured_data do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": <%= @post.title.to_json %>,
    "description": <%= @post.excerpt.to_json %>,
    "datePublished": "<%= @post.published_at %>",
    "author": {
      "@type": "Organization",
      "name": "Arqvexa",
      "url": "<%= site_url %>"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Arqvexa",
      "logo": {
        "@type": "ImageObject",
        "url": "<%= site_url("/icon.png") %>"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<%= site_url(blog_post_path(@post.slug)) %>"
    },
    "image": "<%= og_image_url %>",
    "url": "<%= site_url(blog_post_path(@post.slug)) %>"
  }
  </script>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content" class="page-main">
  <article class="blog-article">
    <header class="blog-article-header">
      <div class="container blog-article-header-inner">
        <%= link_to "← Back to blog", blog_path, class: "blog-back-link" %>
        <span class="blog-category <%= @post.interior? ? "interior-label" : "tech-label" %>"><%= @post.category_label %></span>
        <h1><%= @post.title %></h1>
        <div class="blog-meta">
          <time datetime="<%= @post.published_at %>"><%= @post.formatted_date %></time>
          <span><%= @post.read_time %></span>
        </div>
      </div>
    </header>
    <div class="container blog-article-body prose">
      <%= @post.body.html_safe %>
    </div>
    <footer class="container blog-article-footer">
      <%= render "shared/cta_banner",
            title: "Ready to start your project?",
            text: "Tell us about your requirements and we will reply within 24 hours.",
            button_url: contact_page_path(anchor: "contact") %>
    </footer>
  </article>
</main>

<%= render "shared/footer" %>
