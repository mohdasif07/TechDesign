<% seo_page(
  title: "#{@post.title} | Arqvexa Blog",
  description: @post.excerpt,
  canonical: site_url(blog_post_path(@post.slug)),
  keywords: [
    @post.title,
    @post.category_label,
    @post.slug.tr("-", " "),
    "Arqvexa blog"
  ].join(", ")
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "Blog", url: site_url(blog_path) },
  { label: @post.title, url: site_url(blog_post_path(@post.slug)) }
) %>

<% content_for :structured_data do %>
  <%= json_ld_script(blog_post_schema(@post)) %>
  <%= json_ld_script(breadcrumb_schema(breadcrumb_items)) %>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content" class="page-main">
  <%= render_breadcrumbs %>

  <article class="blog-article">
    <header class="blog-article-header">
      <div class="container blog-article-header-inner">
        <span class="blog-category <%= @post.interior? ? "interior-label" : "tech-label" %>"><%= @post.category_label %></span>
        <h1><%= @post.title %></h1>
        <div class="blog-meta">
          <time datetime="<%= @post.published_at %>"><%= @post.formatted_date %></time>
          <span><%= @post.read_time %></span>
        </div>
      </div>
    </header>
    <div class="container blog-article-body prose">
      <%= @post.body.html_safe %>
    </div>
    <footer class="container blog-article-footer">
      <%= render "shared/cta_banner",
            title: "Ready to start your project?",
            text: "Tell us about your requirements and we will reply within 24 hours.",
            button_url: contact_page_path(anchor: "contact") %>
    </footer>
  </article>
</main>

<%= render "shared/footer" %>
