<% seo_page(
  title: "Contact Arqvexa | Interior Design & IT Development",
  description: "Contact Arqvexa for interior design in Delhi NCR or IT development across India. Email hello@arqvexa.in, phone +91 99176 39330, WhatsApp or our enquiry form.",
  canonical: site_url(contact_page_path),
  keywords: "contact Arqvexa, interior design consultation Delhi NCR, IT development enquiry India, Arqvexa phone, hello@arqvexa.in, book interior designer"
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "Contact", url: site_url(contact_page_path) }
) %>

<% content_for :structured_data do %>
  <%= json_ld_script(breadcrumb_schema(breadcrumb_items)) %>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content" class="page-main">
  <%= render_breadcrumbs %>

  <section class="page-hero page-hero-light page-hero-contact">
    <div class="container">
      <div class="eyebrow"><span></span> Contact</div>
      <h1>Get a quote.</h1>
      <p class="page-lead">Interior design in Delhi NCR or IT development across India — tell us about your project and we'll reply within 24 hours.</p>
      <div class="contact-path-split reveal">
        <%= link_to interior_design_path, class: "contact-path contact-path--interior" do %>
          <strong>Interior project</strong>
          <span>Spaces · Delhi NCR</span>
        <% end %>
        <%= link_to it_development_path, class: "contact-path contact-path--tech" do %>
          <strong>IT project</strong>
          <span>Systems · India &amp; remote</span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="cta-section contact-page" id="contact">
    <div class="container cta-box">
      <div class="reveal">
        <h2>Interior or IT — let's talk.</h2>
        <ul class="contact-details">
          <li><span>Interior</span> Delhi NCR · On-site visits</li>
          <li><span>IT</span> India &amp; remote · Video calls</li>
          <li><span>Email</span> <%= contact_email_link %></li>
          <li><span>Phone</span> <%= link_to contact_phone_display, "tel:#{contact_phone_tel}" %></li>
          <li><span>WhatsApp</span> <%= link_to contact_phone_display, "https://wa.me/919917639330", target: "_blank", rel: "noopener noreferrer" %></li>
        </ul>
      </div>
      <%= render "shared/contact_panel", return_to: contact_page_path(anchor: "contact") %>
    </div>
  </section>

  <% if google_review_url.present? %>
    <section class="section">
      <div class="container">
        <%= render "shared/google_review_cta" %>
      </div>
    </section>
  <% end %>
</main>

<%= render "shared/footer" %>
