<% seo_page(
  title: "IT Development Company in Delhi NCR | Arqvexa",
  description: "Arqvexa is an IT development company in Delhi NCR and Noida — websites, web apps, mobile apps, custom software, e-commerce, CRM, AI and API integrations for growing businesses across India.",
  canonical: site_url(it_development_path),
  keywords: "IT development company Delhi NCR, IT development company Noida, web development company Delhi NCR, software development company Delhi NCR, custom software development Delhi NCR"
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "IT Development", url: site_url(it_development_path) }
) %>

<% content_for :structured_data do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "IT Development Services",
        "provider": {
          "@type": "Organization",
          "name": "Arqvexa",
          "url": "<%= site_url %>"
        },
        "url": "<%= site_url(it_development_path) %>",
        "description": "Websites, web applications, mobile apps, e-commerce, CRM, AI development, AI automation, API integrations and custom software for businesses in India.",
        "areaServed": [
          { "@type": "Country", "name": "India" },
          { "@type": "AdministrativeArea", "name": "Delhi NCR" },
          { "@type": "City", "name": "Noida", "containedInPlace": { "@type": "State", "name": "Uttar Pradesh" } },
          { "@type": "City", "name": "Gurugram", "containedInPlace": { "@type": "State", "name": "Haryana" } },
          { "@type": "City", "name": "Delhi" }
        ],
        "serviceType": ["Web Development", "Website Development", "Mobile App Development", "Software Development", "E-commerce Development", "CRM Development", "AI Development", "AI Automation", "API Integration"]
      }
    ]
  }
  </script>
  <%= json_ld_script(breadcrumb_schema(breadcrumb_items)) %>
  <%= json_ld_script(faq_page_schema([
        { "question" => "How much does a business website cost in India?",
          "answer" => "Professional business websites with Arqvexa start from ₹35,000. Final pricing depends on pages, features and integrations." },
        { "question" => "Do you build mobile apps for Android and iOS?",
          "answer" => "Yes. We recommend cross-platform or native based on requirements, timeline and budget." },
        { "question" => "Do you serve Noida and Delhi NCR?",
          "answer" => "Yes. We focus on Delhi NCR and Noida while delivering IT projects remotely across India." },
        { "question" => "Do you provide maintenance after launch?",
          "answer" => "Yes. Support plans cover bug fixes, updates, hosting guidance and new feature development." }
      ])) %>
  <%= json_ld_script({ "@context" => "https://schema.org", "@graph" => client_reviews_schema(ClientReview.for_division(:it), service_name: "IT Development Services") }) %>
<% end %>

<% content_for :division, "it" %>

<%= render "shared/navigation" %>

<main id="main-content">
  <%= render_breadcrumbs %>

  <section class="page-hero page-hero-tech page-hero-cinematic" data-it-hero>
    <div class="digital-network" aria-hidden="true" style="opacity:0.35;">
      <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
        <g stroke="rgba(0,217,255,0.3)" stroke-width="1" fill="none">
          <circle cx="180" cy="120" r="4" fill="#00D9FF"/>
          <circle cx="420" cy="80" r="4" fill="#4267FF"/>
          <circle cx="700" cy="140" r="4" fill="#7C3AED"/>
          <circle cx="980" cy="100" r="4" fill="#00D9FF"/>
          <circle cx="300" cy="320" r="4" fill="#4267FF"/>
          <circle cx="600" cy="280" r="4" fill="#7C3AED"/>
          <circle cx="900" cy="340" r="4" fill="#00D9FF"/>
          <path d="M180 120 L420 80 L700 140 L980 100 M420 80 L300 320 M700 140 L600 280 M980 100 L900 340 M300 320 L600 280 L900 340"/>
        </g>
      </svg>
    </div>
    <div class="container page-hero-grid reveal">
      <div>
        <div class="eyebrow"><span></span> IT Development · Delhi NCR, Noida &amp; India</div>
        <p class="it-hero-kicker" aria-hidden="true">BUILD. SHIP. SCALE.</p>
        <h1>IT Development Company in <em>Delhi NCR.</em></h1>
        <p class="page-hero-text">Websites, apps, software and AI solutions for growing businesses — built by Arqvexa’s IT division with clear scope, regular demos and maintainable code.</p>
        <p class="page-hero-text" style="margin-top:-8px;opacity:0.85;">Strong focus on Noida and Delhi NCR, with remote delivery across India.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Start Your IT Project <span aria-hidden="true">→</span></a>
          <%= link_to "Web Development in Noida", web_location_path(city: "noida"), class: "btn btn-ghost-light" %>
        </div>
        <ul class="page-hero-tags">
          <li>Websites</li><li>Web Apps</li><li>Mobile</li><li>Software</li><li>AI</li><li>CRM</li>
        </ul>
      </div>
      <div class="page-hero-visual reveal delay-1">
        <div class="it-system-viz" data-it-network aria-label="Arqvexa digital system visualization">
          <svg viewBox="0 0 420 360" role="img" aria-hidden="true">
            <defs>
              <linearGradient id="itNodeGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00D9FF"/><stop offset="100%" stop-color="#7C3AED"/>
              </linearGradient>
            </defs>
            <g class="it-links" stroke="url(#itNodeGlow)" stroke-width="1.2" fill="none" opacity="0.55">
              <path d="M80 80 L210 50 L340 90"/><path d="M210 50 L120 180"/><path d="M210 50 L300 190"/>
              <path d="M120 180 L210 280 L300 190"/><path d="M340 90 L300 190"/>
            </g>
            <g font-family="'Plus Jakarta Sans',sans-serif" font-size="11" fill="#A7ADBD">
              <circle cx="80" cy="80" r="6" fill="#00D9FF"/><text x="95" y="84">Website</text>
              <circle cx="210" cy="50" r="6" fill="#4267FF"/><text x="225" y="54">API</text>
              <circle cx="340" cy="90" r="6" fill="#7C3AED"/><text x="300" y="115">CRM</text>
              <circle cx="120" cy="180" r="6" fill="#00D9FF"/><text x="135" y="184">Database</text>
              <circle cx="300" cy="190" r="6" fill="#4267FF"/><text x="315" y="194">AI</text>
              <circle cx="210" cy="280" r="6" fill="#7C3AED"/><text x="225" y="284">Mobile App</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-prose reveal">
      <h2>What Arqvexa builds</h2>
      <p>We partner with startups, SMEs and operations-heavy teams that need digital products that work — not vanity pages. Typical engagements include business websites, custom web applications, mobile apps, e-commerce stores, CRM systems, AI features, automation and API integrations.</p>
      <p>Interior Design remains an equal division of Arqvexa. This page focuses on IT so searchers and buyers can evaluate our software practice clearly.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow"><span></span> Services</div>
          <h2>IT services we <em>offer.</em></h2>
        </div>
        <p>Every service has its own page — unique intent, process and CTA. Start with the problem you need solved.</p>
      </div>
      <div class="service-link-section reveal">
        <%= render "shared/service_link_grid", services: @it_services, variant: "tech" %>
      </div>
    </div>
  </section>

  <section class="section content-block">
    <div class="container content-prose reveal">
      <h2>Who we work with</h2>
      <p>Founders validating an MVP, service businesses that need leads from Google, retailers moving online, and teams replacing spreadsheet chaos with custom software. Clients are often in <strong>Noida</strong>, <strong>Delhi NCR</strong> and across India via remote delivery.</p>
      <h3>Local IT landing page</h3>
      <p>Looking specifically for a partner in Noida? Visit our <%= link_to "web development company in Noida", web_location_path(city: "noida") %> page for local context, coverage and FAQs.</p>
    </div>
  </section>

  <%= render "shared/tools_section", division: :it %>

  <section class="section work" id="portfolio">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> Portfolio</div>
          <h2>Selected IT <em>projects.</em></h2>
        </div>
        <p>Real software work — <%= link_to "view full portfolio", portfolio_path %>.</p>
      </div>
      <div class="work-grid work-grid-3 reveal">
        <% PortfolioItem.by_category("tech").first(6).each do |item| %>
          <%= render "shared/portfolio_card", item: item, linked: true %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="container">
      <div class="section-head compact reveal">
        <div><div class="eyebrow"><span></span> Process</div><h2>From brief to <em>launch.</em></h2></div>
      </div>
      <div class="steps steps-4">
        <div class="step reveal"><span>01</span><h3>Discovery</h3><p>We map goals, users, features and timeline in a structured kickoff call.</p></div>
        <div class="step reveal delay-1"><span>02</span><h3>Design &amp; Prototype</h3><p>Wireframes and UI design so you see the product before development starts.</p></div>
        <div class="step reveal delay-2"><span>03</span><h3>Development</h3><p>Agile sprints with regular demos — you see progress every week.</p></div>
        <div class="step reveal delay-3"><span>04</span><h3>Launch &amp; Support</h3><p>Deployment, testing, handover docs and optional maintenance plans.</p></div>
      </div>
    </div>
  </section>

  <section class="section content-block content-block-dark">
    <div class="container content-prose reveal">
      <h2>Technologies we use</h2>
      <p>We choose stacks for maintainability and the problem at hand. Common tools include <strong>Ruby on Rails</strong>, <strong>React</strong>, <strong>MySQL</strong>, REST APIs, and production delivery with Nginx and Puma. Mobile approach (cross-platform vs native) is decided after reviewing scope — we do not claim technologies we cannot deliver.</p>
      <h2>Pricing guidance</h2>
      <p><strong>Business websites start from ₹35,000.</strong> Web apps, mobile apps, CRM and AI projects are scoped after discovery. Read the <%= link_to "website cost guide", blog_post_path("website-cost-delhi-ncr") %> and <%= link_to "mobile app cost guide", blog_post_path("mobile-app-development-cost-india") %>, then request a quote with your must-haves.</p>
    </div>
  </section>

  <%= render "shared/client_reviews", division: :it %>

  <%= render "shared/service_areas" %>

  <section class="section content-block">
    <div class="container content-prose reveal">
      <h2>Why choose Arqvexa for IT development?</h2>
      <p>When you search for an <strong>IT development company in Delhi NCR</strong> or a <strong>web development company in Noida</strong>, you need a team that understands business outcomes — speed, SEO, conversion and long-term maintainability — not only screenshots.</p>
      <p>Arqvexa’s IT division is founder-led by <strong>Asif</strong>. You also keep access to our equal <%= link_to "interior design division", interior_design_path %> when space and software should launch together.</p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq-single reveal">
      <div class="eyebrow"><span></span> FAQ</div>
      <h2>IT development <em>questions.</em></h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How much does a business website cost in India?</summary>
          <p>Business websites with Arqvexa start from ₹35,000. Scope changes with pages and integrations — see our <%= link_to "website cost guide", blog_post_path("website-cost-delhi-ncr") %>.</p>
        </details>
        <details class="faq-item">
          <summary>Do you build mobile apps for Android and iOS?</summary>
          <p>Yes. We recommend cross-platform or native based on budget, timeline and features. Details on <%= link_to "mobile app development", it_service_path("mobile-app-development") %>.</p>
        </details>
        <details class="faq-item">
          <summary>Do you serve Noida as well as Delhi NCR?</summary>
          <p>Yes — see <%= link_to "web development in Noida", web_location_path(city: "noida") %>. We also deliver remotely across India.</p>
        </details>
        <details class="faq-item">
          <summary>Do you provide maintenance after launch?</summary>
          <p>Yes. Support plans cover bug fixes, updates, hosting guidance and new feature development.</p>
        </details>
        <details class="faq-item">
          <summary>Do you also offer interior design services?</summary>
          <p>Yes. <%= link_to "Our interior design division", interior_design_path %> serves Delhi NCR for homes, kitchens and office spaces.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-section" id="contact">
    <div class="container cta-box">
      <div class="reveal">
        <div class="eyebrow"><span></span> Start your IT project</div>
        <h2>Ready to build<br><em>your product?</em></h2>
        <p>Share your idea, target users and timeline. We’ll reply with next steps and a discovery call slot.</p>
      </div>
      <%= render "shared/contact_panel",
            default_service: "IT Development",
            return_to: it_development_path(anchor: "contact") %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
