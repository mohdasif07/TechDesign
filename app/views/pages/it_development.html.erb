<% seo_page(
  title: "IT Development Company in Delhi NCR | Web, Mobile & AI | Arqvexa",
  description: "Arqvexa provides web development, e-commerce, mobile apps, AI automation, CRM and custom software for businesses across India — with discovery-led delivery and clear communication.",
  canonical: site_url(it_development_path),
  keywords: "IT development company Delhi NCR, web development Delhi, mobile app development India, AI development, CRM development, custom software India"
) %>

<% breadcrumbs(
  { label: "Home", url: site_url },
  { label: "IT Development", url: site_url(it_development_path) }
) %>

<% content_for :structured_data do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "IT Development Services",
        "provider": {
          "@type": "Organization",
          "name": "Arqvexa",
          "url": "<%= site_url %>"
        },
        "url": "<%= site_url(it_development_path) %>",
        "description": "Website development, mobile apps, e-commerce, CRM, AI chatbots and custom software development for businesses in India and internationally.",
        "areaServed": [
          { "@type": "Country", "name": "India" },
          { "@type": "AdministrativeArea", "name": "Delhi NCR" }
        ],
        "serviceType": ["Web Development", "Mobile App Development", "E-commerce Development", "CRM Development", "AI Automation"]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does a business website cost in India?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A professional business website typically starts from a modest budget for a landing page and scales with pages, features and integrations. We provide a clear quote after understanding your goals."
            }
          },
          {
            "@type": "Question",
            "name": "Do you build mobile apps for Android and iOS?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. We build cross-platform and native mobile applications depending on your requirements, timeline and budget."
            }
          }
        ]
      }
    ]
  }
  </script>
  <script type="application/ld+json"><%= breadcrumb_json_ld(breadcrumb_items) %></script>
<% end %>

<%= render "shared/navigation" %>

<main id="main-content">
  <%= render_breadcrumbs %>

  <section class="page-hero page-hero-tech">
    <div class="container page-hero-grid reveal">
      <div>
        <div class="eyebrow"><span></span> IT Development · India &amp; Remote</div>
        <h1>IT Development Company in <em>Delhi NCR.</em></h1>
        <p class="page-hero-text">Websites, mobile apps, e-commerce, CRM, AI chatbots and custom software — built for businesses that need results, not just a pretty homepage.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Discuss Your Software Project <span aria-hidden="true">→</span></a>
          <%= link_to "View Interior Design", interior_design_path, class: "btn btn-ghost-light" %>
        </div>
        <ul class="page-hero-tags">
          <li>Websites</li><li>Mobile Apps</li><li>E-commerce</li><li>CRM</li><li>AI</li>
        </ul>
      </div>
      <div class="page-hero-visual">
        <div class="visual-digital tall">
          <div class="browser">
            <span></span><span></span><span></span>
            <div class="browser-title">Build. Ship. Scale.</div>
            <div class="browser-lines"></div>
            <div class="code-snippet">
              <span class="code-kw">const</span> app = <span class="code-fn">launch</span>();<br>
              <span class="code-kw">await</span> app.<span class="code-fn">deploy</span>();
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow"><span></span> Services</div>
          <h2>What we <em>build.</em></h2>
        </div>
        <p>Full-stack IT development for startups, SMEs and established businesses — led by founder Asif with a focus on performance, maintainability and business outcomes.</p>
      </div>
      <div class="service-link-section reveal">
        <%= render "shared/service_link_grid", services: @it_services, variant: "tech" %>
      </div>
    </div>
  </section>

  <section class="section work" id="portfolio">
    <div class="container">
      <div class="section-head compact reveal">
        <div>
          <div class="eyebrow"><span></span> Portfolio</div>
          <h2>Digital <em>concepts.</em></h2>
        </div>
        <p>Studio concept projects illustrating the types of websites, apps and software Arqvexa builds — explore full write-ups in our <%= link_to "portfolio", portfolio_path %>.</p>
      </div>
      <div class="work-grid work-grid-3 reveal">
        <% PortfolioItem.by_category("tech").first(3).each do |item| %>
          <%= render "shared/portfolio_card", item: item, linked: true %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="container">
      <div class="section-head compact reveal">
        <div><div class="eyebrow"><span></span> Process</div><h2>From brief to <em>launch.</em></h2></div>
      </div>
      <div class="steps steps-4">
        <div class="step reveal"><span>01</span><h3>Discovery</h3><p>We map goals, users, features and timeline in a structured kickoff call.</p></div>
        <div class="step reveal delay-1"><span>02</span><h3>Design &amp; Prototype</h3><p>Wireframes and UI design so you see the product before development starts.</p></div>
        <div class="step reveal delay-2"><span>03</span><h3>Development</h3><p>Agile sprints with regular demos — you see progress every week.</p></div>
        <div class="step reveal delay-3"><span>04</span><h3>Launch &amp; Support</h3><p>Deployment, testing, handover docs and optional maintenance plans.</p></div>
      </div>
    </div>
  </section>

  <section class="section content-block content-block-dark">
    <div class="container content-prose reveal">
      <h2>Why choose Arqvexa for IT development?</h2>
      <p>When you search for a <strong>web development company in Delhi NCR</strong> or <strong>app developer in Gurgaon</strong>, you need a team that understands business — not just code. Arqvexa's IT division is led by founder <strong>Asif</strong>, who builds websites, apps and software with a focus on speed, SEO, conversion and long-term maintainability.</p>
      <p>We serve clients across <strong>Delhi NCR</strong> and deliver projects <strong>remotely across India</strong>. Whether you need a landing page, an e-commerce store, a mobile app, a CRM or an AI chatbot — you get clear scope, transparent pricing and regular communication throughout.</p>
      <p>Many clients also use our <%= link_to "interior design services", interior_design_path %> when opening a new office or showroom — one studio for both your space and your digital presence.</p>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="container faq-single reveal">
      <div class="eyebrow"><span></span> FAQ</div>
      <h2>IT development <em>questions.</em></h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How much does a business website cost in India?</summary>
          <p>Depends on pages, features and integrations. We provide a clear quote after discovery — see our <%= link_to "website cost guide", blog_post_path("website-cost-delhi-ncr") %> for typical ranges.</p>
        </details>
        <details class="faq-item">
          <summary>Do you build mobile apps for Android and iOS?</summary>
          <p>Yes. We recommend cross-platform or native based on your budget, timeline and feature requirements.</p>
        </details>
        <details class="faq-item">
          <summary>Can you work remotely outside Delhi NCR?</summary>
          <p>Absolutely. Most IT projects are delivered remotely with video calls, shared demos and async updates.</p>
        </details>
        <details class="faq-item">
          <summary>Do you provide maintenance after launch?</summary>
          <p>Yes. Support plans cover bug fixes, updates, hosting guidance and new feature development.</p>
        </details>
        <details class="faq-item">
          <summary>Do you also offer interior design services?</summary>
          <p>Yes. <%= link_to "Our interior design division", interior_design_path %> serves Delhi NCR for homes, kitchens and office spaces.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-section" id="contact">
    <div class="container cta-box">
      <div class="reveal">
        <div class="eyebrow"><span></span> Start your IT project</div>
        <h2>Ready to build<br><em>your product?</em></h2>
        <p>Share your idea, target users and timeline. We'll reply with next steps and a discovery call slot.</p>
      </div>
      <%= render "shared/contact_panel",
            default_service: "IT Development",
            return_to: it_development_path(anchor: "contact") %>
    </div>
  </section>
</main>

<%= render "shared/footer" %>
